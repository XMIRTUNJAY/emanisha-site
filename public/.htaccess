# Canonical host: one 301 to https + non-www for any other host form (www,
# plain http). Keeps a single canonical host for search engines — matches the
# canonical tags, robots.txt and both sitemaps, which all use https://emanisha.in.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_HOST} ^www\.emanisha\.in$ [NC,OR]
	RewriteCond %{HTTPS} off
	RewriteRule ^(.*)$ https://emanisha.in/$1 [R=301,L]
</IfModule>

# emanisha.in cache policy (Apache + Hostinger hcdn).
# Pages and feeds must revalidate every visit so updates show immediately;
# fingerprinted build assets are safe to cache hard; media gets a day.
<IfModule mod_headers.c>
	# HTML pages, sitemaps, feeds, manifests: always revalidate (304 when unchanged).
	<FilesMatch "\.(html|xml|txt|json|webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>

	# Astro's fingerprinted bundles (_astro/* carries a content hash in the name).
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Images, fonts, video, favicons: cache a day, revalidate after.
	<FilesMatch "\.(png|jpe?g|svg|webp|gif|ico|woff2?|ttf|mp4|webm|pdf)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
</IfModule>
