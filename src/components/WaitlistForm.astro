---
import { BOL_MARATHI_APP } from '../data/app';
import { formConfigured } from '../lib/form';

// ONE shared waitlist form. Every email capture on the site uses this.
// Posts to the GitHub Pages Function (/api/contact, kind=notify), which
// delivers to the site owner. The submit is handled in JS so the reader sees
// a status message instead of the endpoint's JSON.
// No mailto anywhere: if the endpoint is empty the build prints a warning
// (below) and the form renders disabled with a contact link instead.
type Props = {
	context: string;
	locale?: 'en' | 'hi';
	layout?: 'inline' | 'stacked';
	showMessage?: boolean;
	buttonLabel?: string;
};

const { context, locale = 'en', layout = 'inline', showMessage = false, buttonLabel } = Astro.props;
const action = BOL_MARATHI_APP.waitlistFormAction;
// The form posts through src/lib/form.ts, so it is enabled whenever the form
// endpoint is configured — not whenever a native action URL is set.
const enabled = formConfigured;

const t =
	locale === 'hi'
		? {
				email: 'ईमेल पता',
				placeholder: 'aap@example.com',
				button: 'सूचित करें',
				message: 'संदेश (वैकल्पिक)',
				disabled: 'वेटलिस्ट जल्द आ रही है — संपर्क पेज देखें।',
			}
		: {
				email: 'Email address',
				placeholder: 'you@example.com',
				button: 'Notify me',
				message: 'Message (optional)',
				disabled: 'Waitlist opening soon — see the contact page.',
			};

const page = Astro.url.pathname;
const nextUrl = new URL('/app/#joined', Astro.site).toString();
---

<form
	class:list={['waitlist-form', layout]}
	action={action || undefined}
	method="POST"
	data-funnel="waitlist_signup"
	data-cta-context={context}
>
	<label class="vh" for={`wl-${context}`}>{t.email}</label>
	<input
		id={`wl-${context}`}
		type="email"
		name="email"
		placeholder={t.placeholder}
		required
		autocomplete="email"
		disabled={!enabled}
		data-funnel="waitlist_click"
	/>
	{showMessage && <textarea name="message" placeholder={t.message} rows="3" disabled={!enabled}></textarea>}
	<input type="hidden" name="kind" value="notify" />
	<input type="hidden" name="source" value={context} />
	<input type="hidden" name="_subject" value={BOL_MARATHI_APP.waitlistSubject} />
	<input type="hidden" name="_next" value={nextUrl} />
	<input type="hidden" name="page" value={page} />
	<input type="hidden" name="language" value={locale} />
	<input type="hidden" name="referrer" value="" data-referrer />
	<input type="text" name="website" class="vh" tabindex="-1" autocomplete="off" aria-hidden="true" />
	<button type="submit" disabled={!enabled}>{buttonLabel ?? t.button}</button>
	{!enabled && <p class="note">{t.disabled}</p>}
	<p class="waitlist-status" role="status" aria-live="polite" data-waitlist-status hidden></p>
</form>

<script is:inline>
	(function () {
		// Fills the referrer field; form works without it.
		try {
			document.querySelectorAll('[data-referrer]').forEach((el) => {
				el.value = document.referrer || '';
			});
		} catch (e) {}

		// Submit through fetch so the reader gets a status message rather than
		// the endpoint's JSON. Each form on the page handles itself.
		document.querySelectorAll('form.waitlist-form').forEach((form) => {
			const status = form.querySelector('[data-waitlist-status]');
			const button = form.querySelector('button[type="submit"]');
			if (!status || !button) return;

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const original = button.textContent;
				button.disabled = true;
				button.textContent = '…';
				status.hidden = false;
				status.textContent = 'Sending…';

				const data = Object.fromEntries(new FormData(form));
				try {
					const { submitForm } = await import('/src/lib/form.ts');
					const result = await submitForm({
						kind: 'notify',
						email: String(data.email ?? ''),
						message: data.message ? String(data.message) : undefined,
						source: String(data.source ?? ''),
						website: data.website ? String(data.website) : undefined,
					});
					if (!result.ok) throw new Error(result.error);
					status.textContent = 'Thanks — you are on the list.';
					form.reset();
				} catch (error) {
					status.textContent =
						'Could not sign you up right now. Please try again, or email mrxubr@gmail.com.';
				} finally {
					button.disabled = false;
					button.textContent = original;
				}
			});
		});
	})();
</script>

<style>
	.waitlist-form {
		display: flex;
		gap: 0.5em;
		margin-top: 0.75em;
	}
	.waitlist-form.inline {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.waitlist-form.stacked {
		flex-direction: column;
		align-items: stretch;
	}
	.waitlist-form input[type='email'],
	.waitlist-form textarea {
		font: inherit;
		font-size: 1rem;
		color: rgb(var(--gray-dark));
		background: var(--card);
		border: var(--border);
		border-radius: var(--radius);
		padding: 0.7em 1em;
		min-height: 52px;
	}
	.waitlist-form.inline input[type='email'] {
		flex: 1;
		min-width: 0;
	}
	.waitlist-form textarea {
		resize: vertical;
	}
	.waitlist-form button {
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: #fff;
		background: var(--accent);
		border: none;
		border-radius: var(--radius);
		padding: 0 1.5em;
		min-height: 52px;
		cursor: pointer;
		white-space: nowrap;
	}
	.waitlist-form button:hover:not(:disabled) {
		filter: brightness(0.92);
	}
	.waitlist-form button:disabled {
		opacity: 0.55;
		cursor: default;
	}
	.waitlist-form .note {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0.5em 0 0 0;
	}
	.waitlist-form .waitlist-status {
		font-size: 0.9rem;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		margin: 0.5em 0 0 0;
	}
	.waitlist-form .waitlist-status[hidden] {
		display: none;
	}
	.vh {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}
</style>
