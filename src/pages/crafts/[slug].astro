---
import IndieLayout from '../../layouts/IndieLayout.astro';

export interface Craft {
	slug: string;
	tag: string;
	title: string;
	lede: string;
	body: string[];
	points: string[];
	links: { label: string; href: string }[];
}

export const crafts: Craft[] = [
	{
		slug: 'ai-data-engineer',
		tag: 'PROFESSION',
		title: 'AI & Data Engineer',
		lede: 'Post-trade finance by profession — pipelines and data systems where accuracy is the entire job.',
		body: [
			'By day I build the data plumbing behind post-trade finance: ingestion, validation, reconciliation — systems where a wrong number is not a bug report but a settlement failure.',
			'Machine learning enters where rules run out: anomaly detection on breaks, classification on messy reference data, forecasting on volumes. Models serve the pipeline, never the other way round.',
		],
		points: ['Settlement-critical pipelines with validation gates', 'ML for data quality: anomalies, breaks, forecasts', 'Every run observable, every number explainable'],
		links: [
			{ label: 'DE/AGENT project', href: '/projects/data-engineer/' },
			{ label: 'Engineering notebook', href: 'https://xmirtunjay.github.io/engineering-notebook/' },
		],
	},
	{
		slug: 'app-builder',
		tag: 'BUILDER',
		title: 'App Builder',
		lede: 'Small, shippable apps: language learning, wellness concepts, news scrolls. Built, not pitched.',
		body: [
			'The rule is simple: if it cannot ship in weeks, it gets cut until it can. Bol Marathi — games, guides, dictionary, all live — is what that discipline produces.',
			'Wellness and news concepts follow the same path: one honest screen at a time, tested with real hands before any announcement.',
		],
		points: ['Live: Bol Marathi with 5 games and 215 guides', 'Concepts: Dhyaana, Clarity — one screen at a time', 'Static-first: fast, offline-friendly, cheap to run'],
		links: [
			{ label: 'Try Bol Marathi', href: '/learn-marathi/' },
			{ label: 'All projects', href: '/#work' },
		],
	},
	{
		slug: 'automation-builder',
		tag: 'AUTOMATION',
		title: 'Automation Builder',
		lede: 'Agents and workflows that quietly do the boring work. DE/AGENT is where this is heading.',
		body: [
			'The best automation is invisible: nightly checks, self-healing imports, reports that write themselves. I build workflows with human approval gates — the agent proposes, a person disposes.',
			'DE/AGENT is this philosophy as a product: orchestrated work, observable execution, reliability first.',
		],
		points: ['Human-in-the-loop approval gates on every workflow', 'Observable runs: logs, metrics, replayable steps', 'Boring technology chosen on purpose'],
		links: [
			{ label: 'DE/AGENT project', href: '/projects/data-engineer/' },
			{ label: 'Engineering notebook', href: 'https://xmirtunjay.github.io/engineering-notebook/' },
		],
	},
	{
		slug: 'philosophy-mythology',
		tag: 'CONTEMPLATION',
		title: 'Philosophy & Mythology',
		lede: 'Vedanta, Stoicism, Greek myths — old stories that keep shaping the new builds.',
		body: [
			'The Gita on detached action reads like a runbook for on-call rotations. Marcus Aurelius on obstacles reads like incident review guidance. The old stories keep turning out to be documentation.',
			'This thread runs through everything here: Dhyaana draws on contemplative practice, and the notebook keeps returning to what the philosophers got right about building.',
		],
		points: ['Vedanta and Stoicism as engineering philosophy', 'Myth as documentation: patterns older than software', 'Notes on thinking in the notebook'],
		links: [
			{ label: 'Notebook', href: '/updates/' },
			{ label: 'Dhyaana concept', href: '/projects/headspace-india/' },
		],
	},
];

export function getStaticPaths() {
	return crafts.map((craft) => ({ params: { slug: craft.slug }, props: { craft } }));
}
const { craft } = Astro.props;
---

<IndieLayout
	title={`${craft.title} — eManisha`}
	description={craft.lede}
	canonicalPath={`/crafts/${craft.slug}/`}
>
	<header class="site-header rail">
		<a class="brand" href="/" aria-label="eManisha home"
			><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span class="brand-word">eManisha</span><i>.</i></a
		>
		<nav class="nav" aria-label="Main navigation">
			<a href="/#work">Work</a>
			<a href="/#about">About</a>
			<a href="/updates/">Notebook</a>
			<a href="/#contact">Say hello</a>
		</nav>
		<div class="header-actions">
			<a class="book-link" href="/book/">Book a chat</a>
			<button class="mobile-menu" aria-label="Open navigation" aria-expanded="false"
				><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg
			></button>
		</div>
	</header>

	<main class="detail-page rail">
		<div class="detail-heading">
			<span class="eyebrow">CRAFT / {craft.tag}</span>
			<h1>{craft.title}</h1>
			<p>{craft.lede}</p>
		</div>
		<div class="detail-description">
			<div>
				<span class="eyebrow">THE PRACTICE</span>
				<h2>How this craft shows up</h2>
			</div>
			<div>
				{craft.body.map((p) => <p>{p}</p>)}
				<ul class="route-points">
					{craft.points.map((pt) => <li>{pt}</li>)}
				</ul>
				<p style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
					{craft.links.map((l) => (
						<a class="button" href={l.href}>{l.label}</a>
					))}
				</p>
			</div>
		</div>
	</main>

	<footer class="site-footer rail">
		<a class="brand" href="/"
			><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span>eManisha.</span></a
		>
		<p>Made with care. And a little curiosity.</p>
		<div>
			<a href="/#contact">Get in touch</a>
			<span>© 2026 eManisha™</span>
		</div>
	</footer>
</IndieLayout>
