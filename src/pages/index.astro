---
import IndieLayout from '../layouts/IndieLayout.astro';
import IndieChrome from '../components/indie/IndieChrome.astro';
import ProjectPreview from '../components/indie/ProjectPreview.astro';
import { projects, posts } from '../data/indie-site';

const title = 'Indie Builds — Small ideas. Thoughtful builds.';
const description =
	'Explore an independent developer\u2019s projects in Marathi learning, student news, wellness, and data. Read notes, book a conversation, or say hello.';
---

<IndieLayout title={title} description={description} canonicalPath="/">
	<header class="site-header rail">
		<a class="brand" href="/" aria-label="Indie builds home"
			><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span>indie<span class="brand-light"> / builds</span><i>.</i></span></a
		>
		<nav class="nav" aria-label="Main navigation">
			<a href="/#work">Work</a>
			<a href="/#about">About</a>
			<a href="/updates/">Notebook</a>
			<a href="/#contact">Say hello
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
			</a>
		</nav>
		<div class="header-actions">
			<a class="book-link" href="/book/">Book a chat
				<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
			</a>
			<button class="mobile-menu" aria-label="Open navigation" aria-expanded="false"
				><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg
			></button>
		</div>
	</header>

	<main>
		<section class="hero" aria-labelledby="intro">
			<div class="intro-label"><span class="status-dot"></span> INDEPENDENT DEVELOPER. CURIOUS HUMAN.</div>
			<h1 id="intro">Small ideas.<br />Thoughtful <span>builds.<svg viewBox="0 0 380 20" aria-hidden="true"><path d="M4 14 Q 180 -3 372 10 M24 19 Q195 4 345 15"></path></svg></span></h1>
			<svg class="hero-spark" xmlns="http://www.w3.org/2000/svg" width="37" height="37" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path></svg>
			<p>I turn curiosity into things you can use.<br />A collection of apps, websites, and experiments — built with care.</p>
			<div class="hero-actions">
				<a class="button" href="#work">Explore my work
					<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
				</a>
				<a class="text-link" href="/book/">Let&rsquo;s build something
					<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
				</a>
			</div>
			<div class="hero-note">A little code. A lot of curiosity.</div>
		</section>

		<section class="work rail reveal" id="work">
			<div class="section-heading">
				<div><span class="eyebrow">THE PROJECT SHELF</span><h2>Built with a purpose.<span class="count">(04)</span></h2></div>
				<p>Different ideas. The same thoughtful approach.</p>
			</div>
			<div class="filter-row" aria-label="Filter projects">
				{['All builds', 'Education', 'Wellness', 'Web & data'].map((item) => (
					<button type="button" aria-pressed={item === 'All builds'} class:list={[{ selected: item === 'All builds' }]} data-filter={item}>
						{item}{item === 'All builds' && <span>4</span>}
					</button>
				))}
			</div>
			<div class="project-grid">
					{
					projects.map((project, index) => (
						<a class="project-card reveal" href={`/projects/${project.slug}/`} data-category={project.category}>
							<ProjectPreview project={project} live={project.slug === 'marathi-learning'} />
							<div class="project-info">
								<div class="project-meta">
									<span>{project.category}</span>
									<span>0{index + 1} / BUILD</span>
								</div>
								<div class="project-title">
									<h3>{project.name}</h3>
									<span class="arrow-box">
										<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
									</span>
								</div>
								<p>{project.description}</p>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<section class="live-band reveal" aria-label="Live now: the Marathi build">
			<div>
				<span class="eyebrow">LIVE NOW</span>
				<h2>Play Marathi in your browser.</h2>
				<p>The concept became real: five games, 215 guides and a full dictionary — free, no sign-up, running right here on this site.</p>
				<div class="live-stats">
					<div><b>5</b><span>GAMES</span></div>
					<div><b>215</b><span>GUIDES</span></div>
					<div><b>1167</b><span>WORDS</span></div>
				</div>
				<div class="live-cta-row">
					<a class="button" href="/learn-marathi/games/marathi-wordle/">Play now
						<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
					</a>
					<a class="ghost-link" href="/learn-marathi/">Explore the build</a>
				</div>
			</div>
			<div class="live-word" lang="mr">नमस्कार<small>NAMASKĀR · HELLO</small></div>
		</section>

		<section class="about rail reveal" id="about">
			<div class="about-photo">
				<img
					src="https://images.hostinger.com/9783d01a-a4ce-45e2-8b04-7f5682ad2251.png"
					alt="A sunlit desk with a sketchbook, coffee, and project sketches"
					loading="lazy"
				/>
				<span>THE SPACE BETWEEN IDEAS & CODE</span>
			</div>
			<div class="about-copy">
				<span class="eyebrow">A LITTLE ABOUT ME</span>
				<h2>A builder at heart.<br />A learner, always.</h2>
				<p>I&rsquo;m an independent developer drawn to useful ideas and the people behind them. My work moves between language, news, wellness, and data.</p>
				<p>This is my little corner of the internet: a place to share what I&rsquo;m building, what I&rsquo;m thinking about, and what might come next.</p>
				<a class="text-link" href="#contact">Have something in mind? Say hello
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
				</a>
			</div>
		</section>

		<section class="updates rail reveal" id="updates">
			<div class="section-heading">
				<div><span class="eyebrow">FROM THE NOTEBOOK</span><h2>Notes along the way.</h2></div>
				<a class="text-link" href="/updates/">All updates
					<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
				</a>
			</div>
			<div class="update-list">
				{
					posts.map((post, index) => (
						<a href={`/updates/${post.slug}/`}>
							<span class="update-number">0{index + 1}</span>
							<span class="update-category">{post.category}</span>
							<div>
								<h3>{post.title}</h3>
								<p>{post.excerpt}</p>
							</div>
							<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
						</a>
					))
				}
			</div>
		</section>

		<section class="contact-wrap" id="contact">
			<div class="contact rail reveal">
				<div>
					<span class="eyebrow">GOOD THINGS START WITH A HELLO</span>
					<h2>Your idea.<br />Our next conversation.</h2>
					<p>A project, a question, or just a friendly hello?<br />I&rsquo;d love to hear what&rsquo;s on your mind.</p>
					<a class="text-link" href="/book/">Prefer a conversation? Book a time
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
					</a>
				</div>
				<form id="contact-form">
					<div class="form-pair">
						<label>Your name<input name="name" required maxlength="120" placeholder="How should I call you?" autocomplete="name" /></label>
						<label>Email address<input name="email" type="email" required placeholder="you@example.com" autocomplete="email" /></label>
					</div>
					<label>What&rsquo;s on your mind?<textarea name="message" required minlength="10" maxlength="5000" rows="4" placeholder="Tell me a little about your idea…"></textarea></label>
					<div class="form-bottom">
						<span>Your details stay private.</span>
						<button class="button" type="submit">Send a message
							<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
						</button>
					</div>
					<p class="form-status" role="status"></p>
				</form>
			</div>
		</section>

		<section class="newsletter rail reveal">
			<div>
				<span class="eyebrow">LET&rsquo;S STAY IN THE LOOP</span>
				<h2>A little update, now and then.</h2>
				<p>New builds, fresh notes, and things worth sharing.</p>
			</div>
			<form id="newsletter-form">
				<label class="sr-only" for="newsletter-email">Email address</label>
				<div class="newsletter-input">
					<input id="newsletter-email" name="email" type="email" required placeholder="Your email address" autocomplete="email" />
					<button aria-label="Sign up for updates" type="submit"
						><svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
					></button>
				</div>
				<label class="consent"><input type="checkbox" required /> I agree to receive email updates. I can unsubscribe anytime.</label>
				<p role="status"></p>
			</form>
		</section>
	</main>

	<footer class="site-footer rail">
		<a class="brand" href="/"
			><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span>indie / builds.</span></a
		>
		<p>Made with care. And a little curiosity.</p>
		<div>
			<a href="/#contact">Get in touch
				<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
			</a>
			<span>© 2026 Indie Builds</span>
		</div>
	</footer>
</IndieLayout>

<script>
	// project filter
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-row button');
	const cards = document.querySelectorAll<HTMLElement>('.project-card');
	for (const btn of buttons) {
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			for (const other of buttons) {
				other.setAttribute('aria-pressed', String(other === btn));
				other.classList.toggle('selected', other === btn);
			}
			for (const card of cards) {
				card.style.display = f === 'All builds' || card.dataset.category === f ? '' : 'none';
			}
		});
	}

	// mobile nav
	const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu');
	const nav = document.querySelector<HTMLElement>('.nav');
	menuBtn?.addEventListener('click', () => {
		const open = nav?.classList.toggle('open');
		menuBtn?.setAttribute('aria-expanded', String(!!open));
	});

	// forms — static build: store to a configurable PocketBase when present,
	// otherwise show a graceful offline message
	const PB = ''; // set to e.g. 'https://db.emanisha.in' when PocketBase is live
	async function post(collection: string, data: Record<string, unknown>) {
		if (!PB) throw new Error('offline');
		const res = await fetch(`${PB}/api/collections/${collection}/records`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data),
		});
		if (!res.ok) throw new Error('failed');
	}
	const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
	contactForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const status = contactForm.querySelector<HTMLElement>('.form-status');
		const data = Object.fromEntries(new FormData(contactForm));
		try {
			await post('enquiries', data);
			if (status) status.textContent = 'Thanks for reaching out! Your message has been saved.';
			contactForm.reset();
		} catch {
			if (status)
				status.textContent = 'Could not send right now — please email hello@emanisha.in and it will reach me.';
		}
	});
	const newsForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
	newsForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const status = newsForm.querySelector<HTMLElement>('[role="status"]');
		const data = Object.fromEntries(new FormData(newsForm));
		try {
			await post('newsletter_contacts', { ...data, consent: true });
			if (status) status.textContent = 'You\u2019re on the list. Thanks for joining!';
			newsForm.reset();
		} catch {
			if (status) status.textContent = 'Could not sign you up right now. Please try again later.';
		}
	});
</script>

<style>
	.live-pill {
		color: #1a7f37;
		border: 1px solid #1a7f37;
		background: #eaf6ee;
		font-weight: 700;
		letter-spacing: 0.6px;
	}
</style>

<style>
	/* premium card motion */
	.project-card .project-preview {
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.3s ease;
	}
	.project-card:hover .project-preview {
		transform: translateY(-4px);
		box-shadow: 0 22px 48px rgba(48, 43, 39, 0.16);
	}
</style>
