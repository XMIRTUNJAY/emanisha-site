<script>
	// project tabs + sliding visual stack (directional, neighbors peek)
	const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.show-tabs [role="tab"]'));
	const panels = Array.from(document.querySelectorAll<HTMLElement>('.show-panel'));
	const shots = Array.from(document.querySelectorAll<HTMLAnchorElement>('.show-shot'));
	const progressFill = document.getElementById('show-progress-fill');
	const reduceMotionShowcase =
		typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	let currentShow = 0;
	let typeTimer: number | undefined;
	function typePrompt(shot: HTMLElement | undefined) {
		window.clearTimeout(typeTimer);
		document.querySelectorAll('.show-prompt.typing').forEach((el) => el.classList.remove('typing'));
		if (!shot || reduceMotionShowcase) return;
		const target = shot.querySelector<HTMLElement>('.show-prompt > span:first-child');
		const box = shot.querySelector('.show-prompt');
		const full = target?.dataset.prompt;
		if (!target || !box || !full) return;
		target.textContent = '';
		box.classList.add('typing');
		let i = 0;
		const step = () => {
			i++;
			target.textContent = full.slice(0, i);
			if (i < full.length) {
				typeTimer = window.setTimeout(step, 18);
			} else {
				box.classList.remove('typing');
			}
		};
		typeTimer = window.setTimeout(step, 350);
	}
	function paintShow(n: number, dir: number) {
		for (const t of tabBtns) {
			const on = tabBtns.indexOf(t) === n;
			t.classList.toggle('selected', on);
			t.setAttribute('aria-selected', String(on));
		}
		for (const p of panels) {
			const on = panels.indexOf(p) === n;
			p.classList.toggle('active', on);
			p.setAttribute('aria-hidden', String(!on));
		}
		const total = shots.length;
		const prev = (n - 1 + total) % total;
		const next = (n + 1) % total;
		shots.forEach((s, i) => {
			s.classList.remove('active', 'peek-prev', 'peek-next', 'enter-below', 'enter-above');
			s.setAttribute('tabindex', '-1');
			s.setAttribute('aria-hidden', 'true');
			if (i === n) {
				if (dir !== 0 && !reduceMotionShowcase) s.classList.add(dir > 0 ? 'enter-below' : 'enter-above');
				void s.offsetWidth;
				s.classList.remove('enter-below', 'enter-above');
				s.classList.add('active');
				s.setAttribute('tabindex', '0');
				s.setAttribute('aria-hidden', 'false');
			} else if (i === prev) {
				s.classList.add('peek-prev');
			} else if (i === next) {
				s.classList.add('peek-next');
			}
		});
		typePrompt(shots[n]);
		if (progressFill) progressFill.style.height = `${Math.round(((n + 1) / shots.length) * 100)}%`;
	}
	function showProject(slug: string | undefined) {
		const n = tabBtns.findIndex((t) => t.dataset.tab === slug);
		if (n < 0 || n === currentShow) return;
		const dir = n > currentShow ? 1 : -1;
		currentShow = n;
		paintShow(n, dir);
	}
	paintShow(0, 0);
	for (const t of tabBtns) {
		t.addEventListener('click', () => { showProject(t.dataset.tab); showAuto(); });
		t.addEventListener('keydown', (e) => {
			if ((e as KeyboardEvent).key !== 'ArrowRight' && (e as KeyboardEvent).key !== 'ArrowLeft') return;
			e.preventDefault();
			const i = tabBtns.indexOf(t);
			const n = (i + ((e as KeyboardEvent).key === 'ArrowRight' ? 1 : -1) + tabBtns.length) % tabBtns.length;
			tabBtns[n].focus();
			showProject(tabBtns[n].dataset.tab);
			showAuto();
		});
	}
	function stepProject(dir: 1 | -1) {
		const n = (currentShow + dir + tabBtns.length) % tabBtns.length;
		showProject(tabBtns[n].dataset.tab);
		tabBtns[n].scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduceMotionShowcase ? 'auto' : 'smooth' });
	}
	document.getElementById('shelf-prev')?.addEventListener('click', () => { stepProject(-1); showAuto(); });
	document.getElementById('shelf-next')?.addEventListener('click', () => { stepProject(1); showAuto(); });
	// autoscroll: advance while the shelf is visible and untouched
	const showcaseSection = document.getElementById('work');
	let showTimer: number | undefined;
	function showAuto() {
		if (reduceMotionShowcase) return;
		window.clearInterval(showTimer);
		showTimer = window.setInterval(() => stepProject(1), 4000);
	}
	showcaseSection?.addEventListener('mouseenter', () => window.clearInterval(showTimer));
	showcaseSection?.addEventListener('mouseleave', showAuto);
	showcaseSection?.addEventListener('focusin', () => window.clearInterval(showTimer));
	showcaseSection?.addEventListener('focusout', showAuto);
	if (showcaseSection && 'IntersectionObserver' in window) {
		new IntersectionObserver((entries) => {
			if (entries[0].isIntersecting) showAuto();
			else window.clearInterval(showTimer);
		}, { threshold: 0.2 }).observe(showcaseSection);
	} else {
		showAuto();
	}

// hero slideshow: auto-rotating app bands, pause on hover/focus
	const heroSlides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
	
	const heroBox = document.getElementById('hero-slides');
	let heroIdx = 0;
	let heroTimer: number | undefined;
	const reduceMotion =
		typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	function showSlide(i: number) {
		if (!heroSlides.length) return;
		heroIdx = (i + heroSlides.length) % heroSlides.length;
		for (const s of heroSlides) {
			const on = Number(s.dataset.slide) === heroIdx;
			s.classList.toggle('active', on);
			const cur = document.getElementById('hero-cur');
			if (cur) cur.textContent = String(heroIdx + 1).padStart(2, '0');
			if (on) s.removeAttribute('inert');
			else s.setAttribute('inert', '');
		}
	}
	function heroAuto() {
		if (reduceMotion) return;
		window.clearInterval(heroTimer);
		heroTimer = window.setInterval(() => showSlide(heroIdx + 1), 4000);
	}
	document.querySelector('.hero-slider')?.addEventListener('keydown', (e) => {
		if ((e as KeyboardEvent).key !== 'ArrowRight' && (e as KeyboardEvent).key !== 'ArrowLeft') return;
		showSlide(heroIdx + ((e as KeyboardEvent).key === 'ArrowRight' ? 1 : -1));
		heroAuto();
	});
	heroBox?.addEventListener('mouseenter', () => window.clearInterval(heroTimer));
	heroBox?.addEventListener('mouseleave', heroAuto);
	heroBox?.addEventListener('focusin', () => window.clearInterval(heroTimer));
	heroBox?.addEventListener('focusout', heroAuto);
	showSlide(0);
	heroAuto();

	// overlay header: stay transparent-white for the whole dark hero,
	// switch to white glass only once page content scrolls underneath
	var overHeader = document.querySelector('.site-header.over-hero');
	var onScrollHeader = function () {
		if (!overHeader || !heroBox) return;
		var past = window.scrollY > heroBox.offsetHeight - 120;
		overHeader.classList.toggle('is-scrolled', past);
	};
	window.addEventListener('scroll', onScrollHeader, { passive: true });
	onScrollHeader();
	if (reduceMotion) {
		document.querySelectorAll('.hero-chart svg').forEach(function (sv) {
			try { sv.pauseAnimations(); } catch (e) { /* ignore */ }
		});
	}
	// mobile nav is owned by IndieLayout.bindNav (single handler)

		// route showcase: accordion rows drive a single device stage.
	// Play Store URLs go here the day the apps publish — swap the hrefs only.
	const STORE_URLS: Record<string, string> = {
		bol: '/learn-marathi/',
		dhy: '/projects/headspace-india/',
		cla: '/projects/student-news/',
		dea: '/projects/data-engineer/',
	};
	const STAGE_META: Record<string, [string, string, string]> = {
		bol: ['Bol Marathi', '● LIVE NOW', 'is-live'],
		dhy: ['Dhyaana', 'IN DEVELOPMENT', 'is-soon'],
		cla: ['Clarity', 'CONCEPT', 'is-concept'],
		dea: ['DE/AGENT', 'ON THE ROADMAP', 'is-concept'],
	};
	const routeItems = Array.from(document.querySelectorAll<HTMLElement>('.route-item'));
	const routeStage = document.querySelector<HTMLElement>('.route-stage');
	const appScreens = Array.from(document.querySelectorAll<HTMLElement>('.app-screen'));
	const stageName = document.getElementById('stage-name');
	const stageStatus = document.getElementById('stage-status');
	function setRoute(key: string | null) {
		for (const item of routeItems) {
			const on = key !== null && item.dataset.app === key;
			item.classList.toggle('open', on);
			item.querySelector('button')?.setAttribute('aria-expanded', String(on));
		}
		if (key === null) return; // closing all: leave the stage on the last screen
		for (const s of appScreens) s.classList.toggle('active', s.dataset.app === key);
		resetFlow();
		routeStage?.setAttribute('data-active', key);
		const meta = STAGE_META[key];
		if (meta && stageName && stageStatus) {
			stageName.textContent = meta[0];
			stageStatus.textContent = meta[1];
			stageStatus.className = 'mini-status ' + meta[2];
		}
		const tryBtn = routeItems
			.find((i) => i.dataset.app === key)
			?.querySelector<HTMLAnchorElement>('.try-btn');
		if (tryBtn && STORE_URLS[key]) tryBtn.href = STORE_URLS[key];
	}
	for (const item of routeItems) {
		item.querySelector('button')?.addEventListener('click', () => {
			const key = item.dataset.app ?? 'bol';
			const wasOpen = item.classList.contains('open');
			setRoute(wasOpen ? null : key);
		});
	}
	var flowIdx = 0;
	var flowTimer;
	function paintFlow() {
		var active = document.querySelector('.app-screen.active');
		if (!active) return;
		var pages = active.querySelectorAll('.flow-page');
		pages.forEach(function (pg, i) {
			pg.classList.toggle('on', i === flowIdx % pages.length);
		});
		var dots = active.querySelectorAll('.flow-steps i');
		dots.forEach(function (d, i) {
			d.classList.toggle('on', i === flowIdx % pages.length);
		});
	}
	function resetFlow() {
		flowIdx = 0;
		paintFlow();
		window.clearInterval(flowTimer);
		if (typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		flowTimer = window.setInterval(function () {
			if (document.hidden) return;
			flowIdx++;
			paintFlow();
		}, 3800);
	}
	if (routeItems.length) setRoute('bol');

	// forms — POST to the bundled PHP endpoint (/api/contact.php), which mails
	// the site owner. Same-origin + relative URL, so lift-and-shift safe.
	async function postSite(data: Record<string, unknown>) {
		const res = await fetch('/api/contact.php', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data),
		});
		const body = await res.json().catch(() => ({ ok: false }));
		if (!res.ok || !(body as { ok?: boolean }).ok) throw new Error('failed');
	}
	const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
	contactForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const status = contactForm.querySelector<HTMLElement>('.form-status');
		const data = Object.fromEntries(new FormData(contactForm));
		try {
			await postSite({ kind: 'contact', ...data });
			if (status) status.textContent = 'Thanks for reaching out! Your message has been sent.';
			contactForm.reset();
		} catch {
			if (status)
				status.textContent = 'Could not send right now — please email mrxubr@gmail.com and it will reach me.';
		}
	});
	const newsForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
	newsForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const status = newsForm.querySelector<HTMLElement>('[role="status"]');
		const data = Object.fromEntries(new FormData(newsForm));
		try {
			await postSite({ kind: 'newsletter', source: 'homepage', ...data, consent: true });
			if (status) status.textContent = 'You\u2019re on the list. Thanks for joining!';
			newsForm.reset();
		} catch {
			if (status) status.textContent = 'Could not sign you up right now. Please try again later.';
		}
	});
</script>

