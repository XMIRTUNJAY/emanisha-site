---
import IndieLayout from '../layouts/IndieLayout.astro';
import IndieChrome from '../components/indie/IndieChrome.astro';
import { projects, posts } from '../data/indie-site';

const title = 'eManisha — Small ideas. Thoughtful builds.';
const description =
	'Explore an independent developer\u2019s projects in Marathi learning, student news, wellness, and data. Read notes, book a conversation, or say hello.';
---

<IndieLayout title={title} description={description} canonicalPath="/" image="/og/og-home.png">
	<header class="site-header rail over-hero">
		<a class="brand" href="/" aria-label="eManisha home"
			><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span class="brand-word">eManisha</span><i>.</i></a
		>
		<nav class="nav" aria-label="Main navigation">
			<a href="/#work">Work</a>
			<a href="/#about">About</a>
			<a href="/updates/">Notebook</a>
			<a href="/de-agent/">DE//AGENT</a>
			<a href="/#contact">Say hello
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
			</a>
		</nav>
		<div class="header-actions">
			<a class="book-link" href="/book/">Book a chat
				<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
			</a>
			<button class="mobile-menu" aria-label="Open navigation" aria-expanded="false"
				><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg
			></button>
		</div>
	</header>

	<main>
		<section class="hero-slider" aria-roledescription="carousel" aria-label="Featured builds">
			<div class="hero-slides" id="hero-slides">
				<div class="hero-count" aria-hidden="true"><span id="hero-cur">01</span><i>/</i><span>05</span></div>
				<article class="hero-slide theme-ai active" data-slide="0" aria-label="1 of 5: AI builder">
				<div class="hero-copy">
				<span class="hero-eyebrow">AI BUILDER / DATA ENGINEER</span>
				<h1>Pipelines with a pulse.</h1>
				<p>Post-trade finance systems, ML-driven data quality, and agents that do the boring work - built to settle millions without drama.</p>
				<div class="hero-cta-row">
				<a class="button" href="/#work">See the work</a>
				<a class="ghost-link-light" href="/projects/data-engineer/">How I build</a>
				</div>
				</div>
				<div class="hero-visual" aria-hidden="true">
				<div class="hero-chart">
				<svg viewBox="0 0 320 170" preserveAspectRatio="none">
				<path class="chart-grid" d="M0 34H320M0 68H320M0 102H320M0 136H320" />
				<path class="chart-area" d="M0 140 L40 128 L80 132 L120 104 L160 110 L200 76 L240 84 L280 46 L320 52 L320 170 L0 170 Z" />
				<path class="chart-line" d="M0 140 L40 128 L80 132 L120 104 L160 110 L200 76 L240 84 L280 46 L320 52" />
				<circle r="5" fill="#4ade80"><animateMotion dur="7s" repeatCount="indefinite" path="M0 140 L40 128 L80 132 L120 104 L160 110 L200 76 L240 84 L280 46 L320 52" /></circle>
				</svg>
				<div class="chart-feed">
				<span>&gt; ingest ... 2.1M rows</span>
				<span>&gt; validate ... schema ok</span>
				<span>&gt; agent: forecast ready<span class="caret"></span></span>
				</div>
				</div>
				</div>
				</article>
				<article class="hero-slide theme-bol" data-slide="1" aria-label="2 of 5: Bol Marathi">
					<div class="hero-copy">
						<span class="hero-eyebrow">LIVE NOW · BOL MARATHI</span>
						<h1>Play Marathi in your browser.</h1>
						<p>Five games, 215 guides and a full dictionary — free, no sign-up, running right here.</p>
						<div class="hero-cta-row">
							<a class="button" href="/learn-marathi/games/marathi-wordle/">Play now</a>
							<a class="ghost-link-light" href="/learn-marathi/">Explore the build</a>
						</div>
					</div>
					<div class="hero-visual" aria-hidden="true">
						<span class="hero-big" lang="mr">नमस्कार</span>
						<span class="hero-watermark" lang="mr">मराठी</span>
						<div class="hero-stats"><div><b>5</b><span>GAMES</span></div><div><b>215</b><span>GUIDES</span></div><div><b>1167</b><span>WORDS</span></div></div>
					</div>
				</article>
				<article class="hero-slide theme-dhy" data-slide="2" aria-label="3 of 5: Dhyaana" inert>
					<div class="hero-copy">
						<span class="hero-eyebrow">IN DEVELOPMENT · DHYAANA</span>
						<h1>A calmer digital space.</h1>
						<p>Breathing-led sessions for Indian mornings — short, quiet, and respectful of your attention.</p>
						<div class="hero-cta-row">
							<a class="button" href="/projects/headspace-india/">See the concept</a>
							<a class="ghost-link-light" href="/#contact">Get notified</a>
						</div>
					</div>
					<div class="hero-visual" aria-hidden="true">
						<div class="hero-breath"></div>
						<span class="hero-big" lang="mr">श्वास</span>
						<span class="hero-sub">BREATHE IN · BREATHE OUT</span>
					</div>
				</article>
				<article class="hero-slide theme-cla" data-slide="3" aria-label="4 of 5: Clarity" inert>
					<div class="hero-copy">
						<span class="hero-eyebrow">CONCEPT · CLARITY</span>
						<h1>Big ideas. Small scrolls.</h1>
						<p>A 3-minute morning insight for curious minds and students. Jargon-free, ad-light.</p>
						<div class="hero-cta-row">
							<a class="button" href="/projects/student-news/">See the concept</a>
							<a class="ghost-link-light" href="/#contact">Get notified</a>
						</div>
					</div>
					<div class="hero-visual" aria-hidden="true">
						<div class="hero-article">
							<span>DAILY INSIGHT</span>
							<b>Students decode the budget in 5 minutes</b>
							<i></i>
						</div>
					</div>
				</article>
				<article class="hero-slide theme-dea" data-slide="4" aria-label="5 of 5: DE/AGENT" inert>
					<div class="hero-copy">
						<span class="hero-eyebrow">ON THE ROADMAP · DE/AGENT</span>
						<h1>Pipelines that run themselves.</h1>
						<p>Reliable data workflows and autonomous execution — with a human approving every step.</p>
						<div class="hero-cta-row">
							<a class="button" href="/projects/data-engineer/">See the concept</a>
							<a class="ghost-link-light" href="/#contact">Get notified</a>
						</div>
					</div>
					<div class="hero-visual" aria-hidden="true">
						<div class="hero-term">
							<span>$ agent run --task ship</span>
							<span class="ok">✓ done in 2.4s</span>
						</div>
					</div>
				</article>
			</div>
			
		</section>

		<section class="work rail reveal" id="work">
			<div class="section-heading shelf-head">
				<div><span class="eyebrow">THE PROJECT SHELF</span><h2>Built with a purpose.<span class="count">(0{projects.length})</span></h2></div>
				<div class="shelf-nav">
					<button type="button" id="shelf-prev" aria-label="Show previous project">←</button>
					<button type="button" id="shelf-next" aria-label="Show next project">→</button>
				</div>
			</div>
			<div class="show-tabs" role="tablist" aria-label="Projects">
				{projects.map((project, index) => (
					<button type="button" role="tab" aria-selected={index === 0} class:list={[{ selected: index === 0 }]} data-tab={project.slug}>
						{project.short}
					</button>
				))}
			</div>
			<div class="show-stage">
				<div class="show-visual-stack" aria-hidden="false">
					{
						projects.map((project, index) => (
							<a class:list={['show-shot', { active: index === 0 }]} data-shot={project.slug} href={`/projects/${project.slug}/`} tabindex={index === 0 ? 0 : -1} aria-label={`${project.name} — open project`}>
								<span class="browser">
									<span class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span class="browser-url">emanisha.in/projects/{project.slug}/</span></span>
									<img src={project.image ?? '/og/og-fallback.png'} alt="" loading="lazy" />
									<span class="show-prompt"><span data-prompt={project.prompt ?? project.status ?? project.category}>{project.status ?? project.category}</span><span class="show-go">→</span></span>
								</span>
							</a>
						))
					}
					<div class="show-progress-v" aria-hidden="true"><i id="show-progress-fill"></i></div>
				</div>
				{
					projects.map((project, index) => (
						<article class:list={['show-panel', { active: index === 0 }, project.color]} data-panel={project.slug} aria-hidden={index !== 0}>
							<div class="show-copy">
								<span class="shelf-icon" aria-hidden="true">
									{project.kind === 'marathi' && (
										<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
									)}
									{project.kind === 'news' && (
										<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V9"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path d="M10 6h8v4h-8V6Z"></path></svg>
									)}
									{project.kind === 'wellness' && (
										<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"></circle></svg>
									)}
									{project.kind === 'notes' && (
										<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
									)}
									{project.kind === 'data' && (
										<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
									)}
								</span>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
								<p class="show-meta">{project.category} · 0{index + 1} / 0{projects.length}{project.status ? ` · ${project.status}` : ''}</p>
								<a class="show-link" href={`/projects/${project.slug}/`}>Open project
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="route-band reveal" aria-label="The mobile route">
			<span class="eyebrow">THE MOBILE ROUTE</span>
			<h2>Four apps. One pocket-sized future.</h2>
			<p>Four different ideas, each taking shape in its own way. Explore what&rsquo;s live, what&rsquo;s growing, and what&rsquo;s next.</p>
			<div class="route-showcase">
				<div class="route-list">
					<div class="route-item open" data-app="bol">
						<button type="button" aria-expanded="true">
							<span><b>Bol Marathi</b><i>LIVE NOW · Games, guides & dictionary</i></span>
							<span class="pm" aria-hidden="true"></span>
						</button>
						<div class="route-detail">
							<p>Learn Marathi through lessons, listening, vocabulary, and playful practice.</p>
							<ul class="route-points">
								<li>5 games + dictionary, playable in your browser</li>
								<li>215 guides with audio, free forever</li>
							</ul>
							<div class="route-cta">
								<a class="button try-btn" href="/learn-marathi/">Try Bol Marathi</a>
								<a class="text-link" href="/projects/marathi-learning/">Open its story</a>
							</div>
						</div>
					</div>
					<div class="route-item" data-app="dhy">
						<button type="button" aria-expanded="false">
							<span><b>Dhyaana</b><i>IN DEVELOPMENT · A calmer digital space</i></span>
							<span class="pm" aria-hidden="true"></span>
						</button>
						<div class="route-detail">
							<p>A quieter digital space for meditation, breathwork, and Indian contemplative practices.</p>
							<ul class="route-points">
								<li>Breath-led sessions under 10 minutes</li>
								<li>No streaks, no noise — calm by design</li>
							</ul>
							<div class="route-cta">
								<a class="button try-btn" href="/projects/headspace-india/">Try Dhyaana</a>
								<a class="text-link" href="/#contact">Get notified</a>
							</div>
						</div>
					</div>
					<div class="route-item" data-app="cla">
						<button type="button" aria-expanded="false">
							<span><b>Clarity</b><i>CONCEPT · The daily scroll for curious minds</i></span>
							<span class="pm" aria-hidden="true"></span>
						</button>
						<div class="route-detail">
							<p>A daily scroll of useful knowledge for curious minds and students.</p>
							<ul class="route-points">
								<li>One 3-minute insight every morning</li>
								<li>Student-first, jargon-free, ad-light</li>
							</ul>
							<div class="route-cta">
								<a class="button try-btn" href="/projects/student-news/">Try Clarity</a>
								<a class="text-link" href="/#contact">Get notified</a>
							</div>
						</div>
					</div>
					<div class="route-item" data-app="dea">
						<button type="button" aria-expanded="false">
							<span><b>DE/AGENT</b><i>ON THE ROADMAP · Autonomous builds</i></span>
							<span class="pm" aria-hidden="true"></span>
						</button>
						<div class="route-detail">
							<p>Reliable data workflows and autonomous execution, with human oversight.</p>
							<ul class="route-points">
								<li>Pipelines with human approval gates</li>
								<li>Every run observable, every step logged</li>
							</ul>
							<div class="route-cta">
								<a class="button try-btn" href="/projects/data-engineer/">Try DE/AGENT</a>
								<a class="text-link" href="/#contact">Get notified</a>
							</div>
						</div>
					</div>
				</div>
				<div class="route-stage" data-active="bol" aria-hidden="true">
					<div class="device-frame">
						<span class="phone-notch"></span>
						<div class="device-screen">
							<div class="phone-status"><span>09:41</span><span class="phone-icons"><svg viewBox="0 0 20 14"><rect x="0" y="9" width="3" height="5" rx="1"/><rect x="4.5" y="6" width="3" height="8" rx="1"/><rect x="9" y="3" width="3" height="11" rx="1"/><rect x="13.5" y="0" width="3" height="14" rx="1"/></svg><svg viewBox="0 0 16 12"><path d="M8 10.6a1.4 1.4 0 1 0 0 .01M5.2 8.2a4 4 0 0 1 5.6 0M2.8 5.8a7.4 7.4 0 0 1 10.4 0M.5 3.4a10.6 10.6 0 0 1 15 0" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg><svg viewBox="0 0 25 12"><rect x="0.5" y="0.5" width="20" height="11" rx="3.5" fill="none"/><rect x="2" y="2" width="14" height="8" rx="2"/><path d="M23 4v4" stroke-width="1.6" stroke-linecap="round"/></svg></span></div>
							<div class="app-screen bol-screen active" data-app="bol">
						<div class="flow-page on">
						<div class="as-top"><span>नमस्कार LESSON 3</span><b>+120 XP</b></div>
						<div class="as-word" lang="mr">नमस्कार</div>
						<div class="as-tr">Namaskār · Hello</div>
						<span class="as-listen">🔊 Listen</span>
						<div class="as-progress"><i style="width:68%"></i></div>
						<div class="as-card"><span lang="mr">पाणी</span><span>pāṇī · water · tap the tile in the game</span></div>
						</div>
						<div class="flow-page">
						<span class="as-kicker">PRACTICE · WORDLE</span>
<div class="as-score"><span>SCORE <b>820</b></span><span>STREAK <b>6</b></span></div>
						<div class="tiles"><span class="tile">पा</span><span class="tile">णी</span><span class="tile ghost">?</span></div>
						<div class="as-progress"><i style="width:82%"></i></div>
						<span class="as-alt-note">820 XP · 6-day streak</span>
<span class="as-hint">Tap the tiles in order →</span>
						</div>
						<div class="flow-page">
						<div class="done-ring">✓</div>
						<b class="flow-title">Round complete!</b>
						<span class="as-alt-note">+50 XP · streak saved · Day 6</span>
						<span class="as-next">Next lesson →</span>
						</div>
						<div class="flow-steps"><i class="on"></i><i></i><i></i></div>
					</div>
							<div class="app-screen dhy-screen" data-app="dhy">
						<div class="flow-page on">
						<div class="as-greet"><span>शुभ सकाळ</span><span>Tue · 24°</span></div>
						<div class="as-feat"><span class="as-feat-tag">FEATURED · 10 MIN</span><b>Morning Pranayama</b><span class="as-play">▶ Begin</span></div>
						<div class="as-cats"><span>Breath</span><span>Sleep</span><span>Focus</span></div>
						</div>
						<div class="flow-page">
						<span class="as-kicker">NOW BREATHING</span>
						<div class="breath breath-lg"></div>
						<div class="as-timer">04:32</div>
						<span class="as-alt-note">slow belly breaths · session 2 of 3</span>
						</div>
						<div class="flow-page">
						<span class="as-kicker">THIS WEEK</span>
						<div class="as-big">128<span>min</span></div>
						<div class="as-dots"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i></div>
						<span class="as-alt-note">5 mornings in a row</span>
						</div>
						<div class="flow-steps"><i class="on"></i><i></i><i></i></div>
					</div>
							<div class="app-screen cla-screen" data-app="cla">
						<div class="flow-page on">
						<span class="as-kicker">DAILY INSIGHT · 3 MIN READ</span>
						<b class="as-head">Students decode the budget in 5 minutes</b>
						<p class="as-ex">Three numbers explain where the money goes · and what changes for hostels, books and bus passes.</p>
						<div class="as-progress"><i style="width:34%"></i></div>
						<div class="as-row"><span class="as-save">♡ Save</span><span class="as-next">Continue →</span></div>
						</div>
						<div class="flow-page">
						<span class="as-kicker">TOPICS</span>
						<div class="as-cats"><span>Money</span><span>Science</span><span>Sports</span></div>
						<div class="as-saved"><b>Monsoon arrives over Konkan</b><span>2 min · Geography</span></div>
						<div class="as-saved"><b>ISRO's next launch</b><span>4 min · Science</span></div>
						</div>
						<div class="flow-page">
						<div class="done-ring blue">✓</div>
						<b class="flow-title">Insight complete</b>
						<span class="as-alt-note">Tomorrow: how budgets really work</span>
						<span class="as-next">Next insight →</span>
						</div>
						<div class="flow-steps"><i class="on"></i><i></i><i></i></div>
					</div>
							<div class="app-screen dea-screen" data-app="dea">
						<div class="flow-page on">
						<span class="as-kicker light">PIPELINE · ILLUSTRATIVE PREVIEW</span>
						<div class="as-pipe">
						<div class="as-stage done"><i>✓</i><span>Ingest</span></div><em>→</em>
						<div class="as-stage done"><i>✓</i><span>Validate</span></div><em>→</em>
						<div class="as-stage done"><i>✓</i><span>Transform</span></div><em>→</em>
						<div class="as-stage run"><i></i><span>Publish</span></div>
						</div>
						<div class="as-meta">run #4821 · 2.4s · eu-west</div>
						<div class="as-approve"><span>Deploy to production?</span><b>Approve</b></div>
						<div class="as-log"><span>✓ tests passed 148/148</span><span>✓ bundle 212kb</span></div>
						</div>
						<div class="flow-page">
						<span class="as-kicker light">ACTIVITY</span>
						<div class="as-log big"><span>✓ ingest finished · 2.1M rows</span><span>✓ validate passed · schema v14</span><span>✓ transform done · 2.4s</span><span>· publish waiting approval</span></div>
						</div>
						<div class="flow-page">
						<div class="done-ring green">✓</div>
						<b class="flow-title light">Run #4821 green</b>
						<span class="as-alt-note">148/148 tests · bundle 212kb · 2.4s</span>
						</div>
						<div class="flow-steps"><i class="on"></i><i></i><i></i></div>
					</div>
						</div>
						<div class="phone-home"></div>
					</div>
					<div class="stage-caption">
						<b id="stage-name">Bol Marathi</b>
						<span id="stage-status" class="mini-status is-live">● LIVE NOW</span>
					</div>
				</div>
			</div>
		</section>

		<section class="about rail reveal" id="about">
			<div class="about-banner">
				<div class="about-banner-copy">
