---
import IndieLayout from '../../layouts/IndieLayout.astro';
import { posts } from '../../data/indie-site';

export function getStaticPaths() {
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---

<IndieLayout
	title={`${post.title} — Indie Builds`}
	description={post.excerpt}
	canonicalPath={`/updates/${post.slug}/`}
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: post.title,
		description: post.excerpt,
	}}
>
	<header class="site-header rail">
		<a class="brand" href="/" aria-label="Indie builds home"
			><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span>indie<span class="brand-light"> / builds</span><i>.</i></span></a
		>
		<nav class="nav" aria-label="Main navigation">
			<a href="/#work">Work</a>
			<a href="/#about">About</a>
			<a href="/learn-marathi/">Learn Marathi</a><a href="/updates/" aria-current="page">Notebook</a>
			<a href="/#contact">Say hello</a>
		</nav>
		<div class="header-actions">
			<a class="book-link" href="/book/">Book a chat</a>
			<button class="mobile-menu" aria-label="Open navigation" aria-expanded="false"
				><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg
			></button>
		</div>
	</header>

	<main class="article-page rail">
		<a class="text-link" href="/updates/">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
			All notes</a
		>
		<span class="eyebrow">FROM THE NOTEBOOK / {post.category}</span>
		<h1>{post.title}</h1>
		<p class="article-lead">{post.excerpt}</p>
		{post.body.map((paragraph) => <p>{paragraph}</p>)}
		<a class="text-link" href="/#contact">Continue the conversation
			<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
		</a>
	</main>

	<footer class="site-footer rail">
		<a class="brand" href="/"
			><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v12"></path><path d="M17.196 9 6.804 15"></path><path d="m6.804 9 10.392 6"></path></svg
			><span>indie / builds.</span></a
		>
		<p>Made with care. And a little curiosity.</p>
		<div>
			<a href="/learn-marathi/">Learn Marathi</a><a href="/#contact">Get in touch</a>
			<span>© 2026 Indie Builds</span>
		</div>
	</footer>
</IndieLayout>

<script>
	const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu');
	const nav = document.querySelector<HTMLElement>('.nav');
	menuBtn?.addEventListener('click', () => {
		const open = nav?.classList.toggle('open');
		menuBtn?.setAttribute('aria-expanded', String(!!open));
	});
</script>
