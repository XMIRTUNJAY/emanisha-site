---
import IndieLayout from '../layouts/IndieLayout.astro';

const title = 'Terms of Use — eManisha';
const description = 'The terms for using eManisha.in content, tools, and forms.';
---

<IndieLayout title={title} description={description} canonicalPath="/terms/">
	<main class="article-page rail">
		<span class="eyebrow">TERMS</span>
		<h1>Terms of Use</h1>
		<p class="article-lead">Plain words: content is free to learn from, tools are provided as-is, be kind in forms.</p>
		<h2>Content</h2>
		<p>
			Guides, articles, case studies, and learning materials on eManisha.in are
			free for personal learning. You may quote brief excerpts with attribution
			and a link back. Republishing full pages, guides, or datasets elsewhere
			without permission is not allowed.
		</p>
		<h2>Tools and apps</h2>
		<p>
			Games, dictionaries, calculators, and interactive demos are provided as-is,
			without warranties. Language content is educational material, not certified
			translation; financial content is educational, not financial advice.
		</p>
		<h2>Acceptable use</h2>
		<p>
			No spam, abuse, or automated scraping that degrades the site for others.
			Form submissions with spam, abuse, or unlawful content are ignored and may
			be blocked. Rate limits apply to all forms.
		</p>
		<h2>Liability</h2>
		<p>
			The site is a personal project. To the extent permitted by law, the owner
			is not liable for decisions made based on its content or for any downtime.
		</p>
		<p class="muted">Last updated: October 2026. Questions: <a class="text-link" href="mailto:mrxubr@gmail.com">mrxubr@gmail.com</a>.</p>
		<p><a class="text-link" href="/">Back home</a></p>
	</main>
</IndieLayout>
