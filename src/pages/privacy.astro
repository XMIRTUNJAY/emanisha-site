---
import IndieLayout from '../layouts/IndieLayout.astro';

const title = 'Privacy Policy — eManisha';
const description = 'How eManisha.in collects, uses, and protects your information.';
---

<IndieLayout title={title} description={description} canonicalPath="/privacy/">
	<main class="article-page rail">
		<span class="eyebrow">PRIVACY</span>
		<h1>Privacy Policy</h1>
		<p class="article-lead">Short version: forms you fill reach the site owner by email. Nothing is sold, nothing is shared, analytics are minimal.</p>
		<h2>What is collected</h2>
		<p>
			If you use the contact form, you share your name, email address, and message.
			If you join the newsletter or a notify-me list, you share your email address.
			Server logs (IP address, pages visited, timestamps) are kept briefly by the
			hosting provider for security and diagnostics.
		</p>
		<h2>How it is used</h2>
		<p>
			Contact messages are emailed to the site owner to reply to you. Newsletter
			addresses receive the occasional update you signed up for — roughly one email
			a month, and every email explains how to unsubscribe. Nothing is sold,
			rented, or shared with third parties for marketing.
		</p>
		<h2>Cookies and advertising</h2>
		<p>
			The site itself sets no tracking cookies. If display advertising is enabled
			in the future (e.g. Google AdSense), the ad provider may use cookies to
			serve and measure ads — see Google's advertising privacy policy for details.
			You can block cookies in your browser; the site keeps working.
		</p>
		<h2>Your rights</h2>
		<p>
			Write to <a class="text-link" href="mailto:mrxubr@gmail.com">mrxubr@gmail.com</a> to
			ask what is held about you, correct it, or delete it — including unsubscribing
			from all lists. Requests are answered within a reasonable time.
		</p>
		<p class="muted">Last updated: October 2026.</p>
		<p><a class="text-link" href="/">Back home</a></p>
	</main>
</IndieLayout>
