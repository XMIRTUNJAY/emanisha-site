---
// IndieLayout — shared frame for the main emanisha.in site (the "eManisha
// builds" pages). The learn-marathi section has its own layouts (Base/Learn)
// and never loads this, so the two design systems stay isolated.
export interface Props {
	title: string;
	description: string;
	/** Unique page path with leading slash, e.g. '/projects/marathi-learning/'. */
	canonicalPath?: string;
	/** Page-specific share-card path (served from /og/), defaults to the generic card. */
	image?: string;
	/** Extra <head> JSON-LD blobs. */
	jsonLd?: Record<string, unknown>;
}
const { title, description, canonicalPath = '/', image = '/og/og-fallback.png', jsonLd } = Astro.props;
const site = 'https://emanisha.in';
const canonical = new URL(canonicalPath, site).toString();
const ogImage = new URL(image, site).toString();
import '../styles/main-site.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5034465484755647" crossorigin="anonymous"></script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;650;700;750;800&family=Noto+Sans+Devanagari:wght@400;500;600&display=swap"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="eManisha" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	// mobile nav toggle
	function bindNav() {
		const btn = document.querySelector<HTMLElement>('.mobile-menu');
		const nav = document.querySelector<HTMLElement>('.nav');
		if (!btn || !nav || btn.dataset.bound) return;
		btn.dataset.bound = '1';
		btn.addEventListener('click', () => {
			const open = nav.classList.toggle('open');
			btn.setAttribute('aria-expanded', String(open));
		});
	}
	bindNav();

	// morphing wordmark: emanisha -> eManisha -> e-Manisha -> e/Manisha.
	// Visual only — the link's aria-label stays "eManisha home".
	(function initBrandMorph() {
		var el = document.querySelector<HTMLElement>('.brand-word');
		if (!el) return;
		if (
			typeof window.matchMedia === 'function' &&
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		)
			return;
		var forms = ['emanisha', 'eManisha', 'e-Manisha', 'e/Manisha'];
		var i = 1;
		window.setInterval(function () {
			el!.classList.add('swap');
			window.setTimeout(function () {
				el!.textContent = forms[i % forms.length]!;
				i++;
				el!.classList.remove('swap');
			}, 280);
		}, 2800);
	})();

	// scroll-reveal: sections fade/slide in once, then unobserve.
	// Skipped entirely under prefers-reduced-motion (CSS keeps them visible).
	(function initReveal() {
		var els = document.querySelectorAll('.reveal');
		if (!els.length) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		if (!('IntersectionObserver' in window)) {
			els.forEach(function (el) { el.classList.add('in'); });
			return;
		}
		var io = new IntersectionObserver(
			function (entries) {
				entries.forEach(function (entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('in');
						io.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
		);
		els.forEach(function (el) { io.observe(el); });
	})();
</script>
