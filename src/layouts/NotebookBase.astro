---
import BaseHead from '../components/notebook/BaseHead.astro';
import Lightbox from '../components/notebook/Lightbox.astro';
import SiteFooter from '../components/notebook/SiteFooter.astro';
import SiteHeader from '../components/notebook/SiteHeader.astro';

type Props = {
	title: string;
	description: string;
	ogImage?: string;
};

const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} imageUrl={ogImage} />
	</head>
	<body>
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter />
		<Lightbox />
	</body>
</html>
