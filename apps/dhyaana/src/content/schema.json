{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dhyaana content",
  "description": "Schema for the Dhyaana content database. The app reads these files at build time; tools/validate-dhyaana-content.mjs enforces the rules a JSON schema cannot express (cross-file references, day counts, uniqueness).",
  "definitions": {
    "worldId": {
      "type": "string",
      "enum": ["dhyana", "gyaan", "nidra", "prajna", "pranayama", "therapy"]
    },
    "world": {
      "type": "object",
      "required": ["id", "name", "devanagari", "essence", "description", "cue", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/worldId" },
        "name": { "type": "string", "minLength": 1 },
        "devanagari": { "type": "string", "minLength": 1 },
        "essence": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "cue": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "journey": {
      "type": "object",
      "required": ["id", "title", "eyebrow", "days", "description", "defaultWorld", "defaultMinutes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "days": { "type": "integer", "minimum": 1, "maximum": 120 },
        "description": { "type": "string", "minLength": 20 },
        "defaultWorld": { "$ref": "#/definitions/worldId" },
        "defaultMinutes": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "id",
        "term",
        "devanagari",
        "transliteration",
        "meaning",
        "body",
        "source",
        "question",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "term": { "type": "string", "minLength": 1 },
        "devanagari": { "type": "string", "minLength": 1 },
        "transliteration": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 3 },
        "body": { "type": "string", "minLength": 40 },
        "source": { "type": "string", "minLength": 3 },
        "question": { "type": "string", "minLength": 10 },
        "status": { "type": "string", "enum": ["available", "planned"] }
      }
    },
    "journeyDay": {
      "type": "object",
      "required": ["title", "practice", "minutes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "practice": { "type": "string", "minLength": 1 },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "world": { "$ref": "#/definitions/worldId" }
      }
    }
  },
  "type": "object",
  "required": ["version", "updatedAt", "worlds", "journeys", "knowledge"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/world" }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/journey" }
    },
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/knowledge" }
    }
  }
}
